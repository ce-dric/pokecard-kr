---
import "../styles/site.css";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import { absoluteUrl } from "../lib/sets";
import { SITE_NAME } from "../lib/site";

interface Props {
  title: string;
  description: string;
  image?: string;
  jsonLd?: unknown;
}
const { title, description, image, jsonLd } = Astro.props;
const canonical = Astro.url.href;
const ogImage = image ? absoluteUrl(image) : absoluteUrl(import.meta.env.BASE_URL + "og-default.png");
const json = jsonLd ? JSON.stringify(jsonLd).replace(/</g, "\\u003c") : "";
const GA_MEASUREMENT_ID = "G-PG0T8974W3";
---
<!doctype html>
<html lang="ko">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="google-site-verification" content="Y5bftvQG707VH6gChuqkD09uDjByVr4F5Yk9_tZb93A" />
    <meta name="theme-color" content="#ffffff" />
    <script is:inline async src={`https://www.googletagmanager.com/gtag/js?id=${GA_MEASUREMENT_ID}`}></script>
    <script is:inline set:html={`window.dataLayer = window.dataLayer || [];
function gtag(){dataLayer.push(arguments);}
gtag('js', new Date());
gtag('config', '${GA_MEASUREMENT_ID}');`}></script>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Noto+Sans+KR:wght@400;500;700&display=swap"
      rel="stylesheet"
    />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href={import.meta.env.BASE_URL + "favicon.svg"} type="image/svg+xml" />
    <link rel="icon" href={import.meta.env.BASE_URL + "favicon-32.png"} type="image/png" sizes="32x32" />
    <link rel="icon" href={import.meta.env.BASE_URL + "favicon.ico"} sizes="any" />
    <link rel="apple-touch-icon" href={import.meta.env.BASE_URL + "apple-touch-icon.png"} />
    <link rel="manifest" href={import.meta.env.BASE_URL + "site.webmanifest"} />
    <meta property="og:locale" content="ko_KR" />
    <meta property="og:site_name" content={SITE_NAME} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    {json && <script type="application/ld+json" set:html={json} />}
  </head>
  <body>
    <a class="skip" href="#content">본문으로</a>
    <Header />
    <main id="content">
      <slot />
    </main>
    <Footer />
  </body>
</html>
