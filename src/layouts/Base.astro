---
import "../styles/site.css";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import { absoluteUrl } from "../lib/sets";

interface Props {
  title: string;
  description: string;
  image?: string;
  jsonLd?: unknown;
}
const { title, description, image, jsonLd } = Astro.props;
const canonical = Astro.url.href;
const ogImage = image ? absoluteUrl(image) : absoluteUrl(import.meta.env.BASE_URL + "og-default.svg");
const json = jsonLd ? JSON.stringify(jsonLd).replace(/</g, "\\u003c") : "";
---
<!doctype html>
<html lang="ko">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href={import.meta.env.BASE_URL + "favicon.svg"} type="image/svg+xml" />
    <meta property="og:locale" content="ko_KR" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    {json && <script type="application/ld+json" set:html={json} />}
  </head>
  <body>
    <a class="skip" href="#content">본문으로</a>
    <Header />
    <main id="content">
      <slot />
    </main>
    <Footer />
  </body>
</html>
