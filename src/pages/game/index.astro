---
import gameCss from "./game.css?raw";
import battleCss from "./battle.css?raw";
import Base from "../../layouts/Base.astro";
import { withBase } from "../../lib/sets";
import { SITE_NAME } from "../../lib/site";

const title = `대전 | ${SITE_NAME}`;
const description =
  "봇과 포켓몬 카드 대전을 하는 비공식 팬 페이지입니다. 배틀 엔진은 The Pokemon Company PTCG AI Battle Challenge 엔진입니다.";
---

<Base title={title} description={description}>
  <div class="wrap ptcg-page">
    <Fragment set:html={`<style>${gameCss}${battleCss}</style>`} />
    <header class="ptcg-hero">
      <p class="ptcg-kicker">비공식 팬 페이지</p>
      <div class="ptcg-title-block">
        <span class="ptcg-marker" aria-hidden="true"></span>
        <h1>대전</h1>
      </div>
      <p class="ptcg-lede">봇과 한 판 둡니다. 엔진이 보여 주는 선택지만 누를 수 있습니다.</p>
      <nav class="ptcg-tabs" aria-label="대전 구역">
        <a class="is-active" href={withBase("game/")} aria-current="page">대전</a>
        <a href={withBase("game/rules/")}>놀이방법</a>
      </nav>
    </header>
    <div data-ptcg>
      <p class="ptcg-wait">덱을 고르면 대전이 시작됩니다.</p>
    </div>
    <p class="ptcg-credit">
      배틀 엔진은 The Pokemon Company PTCG AI Battle Challenge의 엔진입니다. 이 페이지는 비공식 팬 페이지이며, 포켓몬 공식 사이트가 아닙니다.
      카드 이미지는 포켓몬 공식 이미지를 줄이고, 구석에 세드릭 / blog.naver.com/mdsd12 워터마크를 넣었습니다. 한국판 목록에 확인된 카드는 한국 공식 이미지를 쓰고, 아직 없는 카드는 일본 공식 카드 이미지를 씁니다. 샘플 덱은 공식 스탠다드(마크 H, I, J)를 따릅니다.
    </p>
  </div>
</Base>

<script>
  import { mountGame } from "../../lib/ptcg/ui.ts";

  mountGame(document.querySelector("[data-ptcg]"));
</script>
