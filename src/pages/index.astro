---
import Base from "../layouts/Base.astro";
import AdSlot from "../components/AdSlot.astro";
import CardTile from "../components/CardTile.astro";
import SetRow from "../components/SetRow.astro";
import { formatWon, setHref, sets, withBase, type CardSet } from "../lib/sets";

const storm = sets.find((item) => item.id === "m6") ?? sets[0];
const spotlight = storm.cards.filter(
  (card) => card.nameKo === "메가레쿠쟈 ex" && (card.rarity === "SAR" || card.rarity === "MUR"),
);
const groups: { series: string; items: CardSet[] }[] = [];
for (const item of sets) {
  const found = groups.find((group) => group.series === item.series);
  if (found) found.items.push(item);
  else groups.push({ series: item.series, items: [item] });
}
const cardTotal = sets.reduce((sum, item) => sum + item.cardCount, 0);
const title = "포켓몬 카드 한국판 카드 리스트";
const description = `한국판 포켓몬 카드 게임 세트별 카드 리스트. ${sets
  .map((item) => `${item.nameKo} ${item.cardCount}종`)
  .join(", ")}을 카드마다 한 페이지로 정리했습니다.`;
const jsonLd = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "WebSite",
      name: "포켓몬 카드 한국판",
      inLanguage: "ko-KR",
      url: Astro.url.href,
      description,
    },
    {
      "@type": "ItemList",
      name: "수록 세트",
      itemListElement: sets.map((item, index) => ({
        "@type": "ListItem",
        position: index + 1,
        name: item.productNameKo,
        url: new URL(setHref(item), Astro.site).href,
      })),
    },
  ],
};
---
<Base title={title} description={description} jsonLd={jsonLd}>
  <div class="wrap">
    <header class="mast">
      <p class="crumbs">한국판 카드 사전</p>
      <div class="mast-row">
        <h1>이 카드 뭐였더라? 한국판으로 바로 찾기.</h1>
        <p class="mast-aside">{sets.length}세트, {cardTotal}장</p>
      </div>
      <p class="lede">팩별, 레어도별로 정리한 한국판 카드 사전이에요.</p>
    </header>
    <AdSlot id="home-top" />
    {groups.map((group) => (
      <section class="catalog">
        <div class="catalog-head">
          <h2>{group.series}</h2>
          <span>{group.items.length}세트</span>
        </div>
        <ul class="set-list">
          {group.items.map((item, index) => (
            <li>
              <SetRow set={item} href={setHref(item)} eager={group === groups[0] && index === 0} useBox>
                <span>{item.releaseDateKr.replaceAll("-", ".")}</span>
                <span>{item.cardCount}장</span>
                {item.packsPerBox > 1 ? (
                  <>
                    <span>팩 {formatWon(item.packPriceKr)}</span>
                    <span>상자 {formatWon(item.boxPriceKr)}</span>
                  </>
                ) : (
                  <span>덱 {formatWon(item.packPriceKr)}</span>
                )}
              </SetRow>
            </li>
          ))}
        </ul>
      </section>
    ))}
    <section class="block">
      <div class="block-head">
        <h2>많이 찾는 카드</h2>
        <a href={withBase("rarity/")}>레어도 일람</a>
      </div>
      <div class="grid grid-spot">
        {spotlight.map((card) => <CardTile set={storm} card={card} eager />)}
      </div>
    </section>
  </div>
</Base>
