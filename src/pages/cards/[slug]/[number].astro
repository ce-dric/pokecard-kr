---
import Base from "../../../layouts/Base.astro";
import AdSlot from "../../../components/AdSlot.astro";
import CardTile from "../../../components/CardTile.astro";
import OpinionLine from "../../../components/OpinionLine.astro";
import { presentCardOpinion } from "../../../lib/opinions.mjs";
import opinions from "../../../data/community/opinions.json";
import {
  OFFICIAL_REGULATION_PDF,
  OFFICIAL_REGULATION_QNA,
  regulationStatus,
} from "../../../lib/regulation.mjs";
import { SITE_NAME } from "../../../lib/site";
import {
  altText,
  cardHeading,
  cardHref,
  collector,
  imageHref,
  neighbors,
  rarityLabel,
  sets,
  siblings,
  typeLabel,
  usesJapaneseName,
  withBase,
  type Card,
  type CardSet,
} from "../../../lib/sets";

export function getStaticPaths() {
  return sets.flatMap((set) =>
    set.cards.map((card) => ({
      params: { slug: set.slug, number: card.number },
      props: { set, card },
    })),
  );
}

interface Props {
  set: CardSet;
  card: Card;
}
const { set, card } = Astro.props;
const opinion = presentCardOpinion(opinions, set.id, card.number);
const heading = cardHeading(card);
const title = `${heading} ${card.rarity} ${collector(card)} | ${set.nameKo}`;
const description = `${set.productNameKo} ${collector(card)} ${card.rarity} ${rarityLabel[card.rarity] || card.rarity} ${heading}. 번호, 레어도, 타입, 공식 카드 페이지를 한곳에서 확인합니다.`;
const imagePath = imageHref(set, card.image);
const { prev, next } = neighbors(set, card);
const related = siblings(set, card);
const pageUrl = Astro.url.href;
const official = card.verifiedUrl || card.krUrl;
const regulation = regulationStatus(card, set);
const jsonLd = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "BreadcrumbList",
      itemListElement: [
        { "@type": "ListItem", position: 1, name: "홈", item: new URL(withBase(""), Astro.site).href },
        { "@type": "ListItem", position: 2, name: set.nameKo, item: new URL(withBase(`sets/${set.slug}/`), Astro.site).href },
        { "@type": "ListItem", position: 3, name: heading, item: pageUrl },
      ],
    },
    {
      "@type": "WebPage",
      name: title,
      description,
      inLanguage: "ko-KR",
      url: pageUrl,
      primaryImageOfPage: new URL(imagePath, Astro.site).href,
      isPartOf: { "@type": "WebSite", name: SITE_NAME, url: new URL(withBase(""), Astro.site).href },
      mainEntity: {
        "@type": "CreativeWork",
        name: heading,
        alternateName: card.nameJa || undefined,
        identifier: collector(card),
        image: new URL(imagePath, Astro.site).href,
        isPartOf: {
          "@type": "CreativeWorkSeries",
          name: set.productNameKo,
          url: set.krProductUrl,
        },
      },
    },
  ],
};
---
<Base title={title} description={description} image={imagePath} jsonLd={jsonLd}>
  <div class="wrap">
    <nav class="crumbs">
      <a href={withBase("")}>세트</a><span>/</span>
      <a href={withBase(`sets/${set.slug}/`)}>{set.nameKo}</a><span>/</span>
      <span class="num">{card.number}</span>
    </nav>
    <div class="card-layout">
      <figure class="card-visual">
        <img
          src={imagePath}
          alt={altText(set, card)}
          width="640"
          height="894"
          fetchpriority="high"
          decoding="async"
        />
        <figcaption class="caption">이미지 출처: 포켓몬 공식</figcaption>
      </figure>
      <div class="card-copy">
        <div class="eyebrow">
          <span class="num">{set.expansionMark} {collector(card)}</span>
          {card.rarity && <span class={`rarity rarity-${card.rarity}`}>{card.rarity}</span>}
        </div>
        <h1>
          {heading}
          {usesJapaneseName(card) && <span class="ja-fallback">일본판 기준</span>}
        </h1>
        <p class="lede">
          {set.productNameKo} {collector(card)}{" "}
          {card.rarity
            ? `${card.rarity}${rarityLabel[card.rarity] && rarityLabel[card.rarity] !== card.rarity ? ` ${rarityLabel[card.rarity]}` : ""}`
            : ""}{" "}
          {heading}.
          카드 종류는 {card.categoryKo}{card.tags.length ? `, ${card.tags.join(", ")}` : ""}입니다.
        </p>
        <dl class="specs">
          <dt>한국 이름</dt>
          <dd>
            {usesJapaneseName(card) ? "확인된 한국 이름 없음" : card.nameKo}
          </dd>
          {card.nameJa && (
            <>
              <dt>일본판 이름</dt>
              <dd>{card.nameJa}</dd>
            </>
          )}
          <dt>번호</dt>
          <dd>{collector(card)}{card.halfKo ? ` (${card.halfKo})` : ""}</dd>
          {card.jpNumber && card.jpNumber !== card.number && (
            <>
              <dt>일본판 번호</dt>
              <dd>{card.printedIn ? `${card.jpNumber}/${card.printedIn}` : card.jpNumber}</dd>
            </>
          )}
          <dt>레어도</dt>
          <dd>
            {card.rarity
              ? `${rarityLabel[card.rarity] && rarityLabel[card.rarity] !== card.rarity ? `${rarityLabel[card.rarity]} ` : ""}${card.rarity}`
              : "표기 없음"}
          </dd>
          <dt>레귤레이션</dt>
          <dd class="regulation-cell">
            <span class="regulation-mark" data-known={regulation.known ? "1" : "0"}>
              {regulation.labelKo}
            </span>
            {regulation.standardLegal && (
              <span class="standard-badge">{regulation.badgeKo}</span>
            )}
            <p class="regulation-cite">
              {regulation.citeKo}.{" "}
              <a href={OFFICIAL_REGULATION_QNA} rel="noopener noreferrer">공식 레귤레이션 안내</a>
              {" / "}
              <a href={OFFICIAL_REGULATION_PDF} rel="noopener noreferrer">2026 배틀 규정 PDF</a>
            </p>
          </dd>
          <dt>종류</dt>
          <dd>{card.categoryKo}</dd>
          {card.type && (
            <>
              <dt>타입</dt>
              <dd>
                <span class={`swatch swatch-${card.type}`} aria-hidden="true"></span>
                {typeLabel[card.type] || card.typeKo}
              </dd>
            </>
          )}
          {card.hp && (
            <>
              <dt>HP</dt>
              <dd class="num">{card.hp}</dd>
            </>
          )}
          {card.illustrator && (
            <>
              <dt>일러스트</dt>
              <dd>{card.illustrator}</dd>
            </>
          )}
          <dt>세트</dt>
          <dd><a class="more" href={withBase(`sets/${set.slug}/`)}>{set.nameKo}</a></dd>
        </dl>
        <ul class="text-links">
          <li><a href={official} rel="noopener noreferrer">한국 공식 카드 페이지</a></li>
          {card.jpUrl && <li><a href={card.jpUrl} rel="noopener noreferrer">일본 공식 카드 페이지</a></li>}
          {card.rarity && (
            <li>
              <a href={withBase(`rarity/#${set.id}-${card.rarity}`)}>{card.rarity} 레어도 목록</a>
            </li>
          )}
        </ul>
        <AdSlot id={`${set.id}-${card.number}`} />
        {related.length > 0 && (
          <section class="related">
            <h2>같은 이름의 다른 카드</h2>
            <div class="grid grid-tight">
              {related.map((other) => <CardTile set={set} card={other} />)}
            </div>
          </section>
        )}
      </div>
    </div>
    {opinion && <OpinionLine opinion={opinion} />}
    {(prev || next) && (
      <nav class="pager" aria-label="앞뒤 카드">
        {prev ? (
          <a class="prev" href={cardHref(set, prev)}>
            <span class="pager-kicker">← 이전</span>
            <span class="pager-name">{cardHeading(prev)}</span>
          </a>
        ) : <span />}
        {next ? (
          <a class="next" href={cardHref(set, next)}>
            <span class="pager-kicker">다음 →</span>
            <span class="pager-name">{cardHeading(next)}</span>
          </a>
        ) : <span />}
      </nav>
    )}
  </div>
</Base>

<style>
  .regulation-cell {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.35rem 0.55rem;
  }

  .regulation-mark {
    font-weight: 600;
    letter-spacing: 0.02em;
  }

  .regulation-mark[data-known="0"] {
    font-weight: 500;
    color: var(--faint);
  }

  .standard-badge {
    display: inline-block;
    padding: 0.12rem 0.45rem;
    border: 1px solid var(--rule-strong);
    border-radius: 3px;
    background: color-mix(in srgb, var(--fill) 70%, transparent);
    color: var(--ink);
    font-size: 12px;
    font-weight: 600;
    line-height: 1.35;
  }

  .regulation-cite {
    flex: 1 0 100%;
    margin: 0;
    color: var(--faint);
    font-size: 11.5px;
    line-height: 1.45;
  }

  .regulation-cite a {
    text-decoration: underline;
    text-underline-offset: 2px;
  }
</style>
