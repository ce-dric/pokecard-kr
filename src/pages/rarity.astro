---
import Base from "../layouts/Base.astro";
import AdSlot from "../components/AdSlot.astro";
import CardTile from "../components/CardTile.astro";
import {
  rarityCounts,
  sets,
  withBase,
} from "../lib/sets";

const title = "레어도 일람 | 포켓몬 카드 한국판";
const description = `${sets.map((set) => `${set.nameKo} ${set.cardCount}종`).join(", ")} 레어도별 카드 목록. 한국 공식 카드 상세에 적힌 레어도만 모았습니다.`;
const jsonLd = {
  "@context": "https://schema.org",
  "@type": "CollectionPage",
  name: title,
  description,
  inLanguage: "ko-KR",
  url: Astro.url.href,
};
---
<Base title={title} description={description} jsonLd={jsonLd}>
  <div class="wrap">
    <header class="mast">
      <p class="crumbs"><a href={withBase("")}>홈</a> / 레어도</p>
      <div class="mast-row">
        <h1>레어도 일람</h1>
      </div>
      <p class="lede">
        레어도는 각 카드의 한국 공식 상세에 적힌 표기입니다. 표기가 없는 카드는 여기 나누지 않습니다.
      </p>
    </header>
    <AdSlot id="rarity-top" />
    {sets.map((set) => {
      const rows = rarityCounts(set);
      return (
        <section class="block" id={set.id}>
          <div class="block-head">
            <h2><a href={withBase(`sets/${set.slug}/`)}>{set.nameKo}</a></h2>
            <a href={withBase(`sets/${set.slug}/`)}>{set.cardCount}장</a>
          </div>
          {set.id === "m6" && (
            <p class="lede">
              스톰에메랄다는 한국 공식 카드 페이지의 표기와 일본 공식 레어도가 같은 카드만 세었습니다.
            </p>
          )}
          {rows.length === 0 && (
            <p class="lede">한국 공식 상세에 레어도 표기가 없어 이 세트는 나누지 않습니다.</p>
          )}
          {rows.length > 0 && (
            <ul class="rarity-index">
              {rows.map((row) => (
                <li>
                  <a href={`#${set.id}-${row.code}`}>
                    <span class={`rarity rarity-${row.code}`}>{row.code}</span>
                    <span class="rarity-name">{row.label === row.code ? "" : row.label}</span>
                    <span class="num">{row.count}장</span>
                  </a>
                </li>
              ))}
            </ul>
          )}
          {rows.map((row) => (
            <section class="rarity-block" id={`${set.id}-${row.code}`}>
              <h2>
                <span class={`rarity rarity-${row.code}`}>{row.code}</span>
                {row.label === row.code ? "" : row.label}
                <span class="rarity-count">{row.count}장</span>
              </h2>
              <div class="grid">
                {set.cards
                  .filter((card) => card.rarity === row.code)
                  .map((card) => <CardTile set={set} card={card} />)}
              </div>
            </section>
          ))}
        </section>
      );
    })}
  </div>
</Base>
