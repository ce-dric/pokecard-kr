---
import Base from "../layouts/Base.astro";
import AdSlot from "../components/AdSlot.astro";
import {
  cardHeading,
  cardHref,
  collector,
  rarityCounts,
  sets,
  withBase,
} from "../lib/sets";

const set = sets[0];
const rows = rarityCounts(set);
const title = `${set.nameKo} 레어도 일람`;
const description = `${set.productNameKo} 레어도별 카드 수와 목록. C ${rows.find((row) => row.code === "C")?.count ?? 0}장부터 MUR까지 ${set.cardCount}종을 나눕니다.`;
const jsonLd = {
  "@context": "https://schema.org",
  "@type": "CollectionPage",
  name: title,
  description,
  inLanguage: "ko-KR",
  url: Astro.url.href,
};
---
<Base title={title} description={description} jsonLd={jsonLd}>
  <div class="wrap">
    <header class="mast">
      <p class="crumbs"><a href={withBase("")}>홈</a> / 레어도</p>
      <div class="mast-row">
        <h1>{set.nameKo} 레어도 일람</h1>
        <a class="mast-aside" href={withBase(`sets/${set.slug}/`)}>{set.cardCount}장</a>
      </div>
      <p class="lede">
        {set.productNameKo} {set.cardCount}종의 레어도입니다. 숫자는 한국 공식 카드 페이지에 적힌 표기와 일본 공식 레어도가 같은 카드만 세었습니다.
      </p>
    </header>
    <AdSlot id="rarity-top" />
    <ul class="rarity-index">
      {rows.map((row) => (
        <li>
          <a href={`#${row.code}`}>
            <span class={`rarity rarity-${row.code}`}>{row.code}</span>
            <span class="rarity-name">{row.label}</span>
            <span class="num">{row.count}장</span>
          </a>
        </li>
      ))}
    </ul>
    {rows.map((row) => (
      <section class="rarity-block" id={row.code}>
        <h2>
          <span class={`rarity rarity-${row.code}`}>{row.code}</span>
          {row.label}
          <span class="rarity-count">{row.count}장</span>
        </h2>
        <ul class="index-list">
          {set.cards
            .filter((card) => card.rarity === row.code)
            .map((card) => (
              <li>
                <a href={cardHref(set, card)}>
                  <span class="num">{collector(card)}</span>
                  <span class="index-name">{cardHeading(card)}</span>
                </a>
              </li>
            ))}
        </ul>
      </section>
    ))}
    <p class="back-link"><a href={withBase(`sets/${set.slug}/`)}>{set.nameKo} 카드 리스트로</a></p>
  </div>
</Base>
