---
import Base from "../../layouts/Base.astro";
import AdSlot from "../../components/AdSlot.astro";
import {
  glossary,
  glossaryHref,
  glossaryIndexHref,
  linkedCardGroups,
  linkedRarities,
  linkedSets,
  rarityIndexHref,
  relatedTerms,
  siteRarityLabel,
  type GlossaryTerm,
} from "../../lib/glossary";
import { cardHeading, cardHref, collector, setHref, withBase } from "../../lib/sets";

export function getStaticPaths() {
  return glossary.map((term) => ({ params: { slug: term.slug }, props: { term } }));
}

interface Props {
  term: GlossaryTerm;
}
const { term } = Astro.props;
const titleCore = term.english.toLowerCase() === term.term.toLowerCase()
  ? term.term
  : `${term.term} (${term.english})`;
const title = `${titleCore} | 포켓몬 카드 용어집`;
const description = term.summary;
const pageUrl = Astro.url.href;
const indexUrl = new URL(glossaryIndexHref(), Astro.site).href;
const homeUrl = new URL(withBase(""), Astro.site).href;
const alternateName = [term.english, ...term.aliases].filter(
  (name) => name && name.toLowerCase() !== term.term.toLowerCase(),
);
const rarities = linkedRarities(term);
const setsForTerm = linkedSets(term);
const groups = linkedCardGroups(term);
const related = relatedTerms(term);
const rarityIndex = rarityIndexHref(term);
const siteLabel = siteRarityLabel(term);
const jsonLd = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "BreadcrumbList",
      itemListElement: [
        { "@type": "ListItem", position: 1, name: "홈", item: homeUrl },
        { "@type": "ListItem", position: 2, name: "용어집", item: indexUrl },
        { "@type": "ListItem", position: 3, name: term.term, item: pageUrl },
      ],
    },
    {
      "@type": "DefinedTerm",
      name: term.term,
      description,
      inLanguage: "ko-KR",
      url: pageUrl,
      alternateName,
      inDefinedTermSet: indexUrl,
    },
  ],
};
const hasLinks = Boolean(rarityIndex || rarities.length || setsForTerm.length || related.length || term.external?.length);
---
<Base title={title} description={description} jsonLd={jsonLd}>
  <div class="wrap">
    <header class="mast">
      <p class="crumbs">
        <a href={withBase("")}>홈</a> /
        <a href={glossaryIndexHref()}>용어집</a> /
        {term.term}
      </p>
      <div class="mast-row">
        <h1>{term.term}</h1>
      </div>
      <p class="lede">{term.summary}</p>
    </header>
    <div class="prose">
      {term.definition.map((paragraph) => <p>{paragraph}</p>)}
    </div>
    <AdSlot id={`glossary-${term.slug}`} />
    <dl class="specs">
      <dt>영어</dt>
      <dd>{term.english}</dd>
      {term.aliases.length > 0 && (
        <>
          <dt>다른 말</dt>
          <dd>{term.aliases.join(", ")}</dd>
        </>
      )}
      {siteLabel && (
        <>
          <dt>이 사이트 표기</dt>
          <dd>{siteLabel}</dd>
        </>
      )}
    </dl>
    {hasLinks && (
      <>
        <div class="catalog-head">
          <h2>관련 페이지</h2>
        </div>
        <ul class="text-links">
          {rarityIndex && (
            <li><a href={rarityIndex}>레어도 일람</a></li>
          )}
          {rarities.map((row) => (
            <li>
              <a href={row.href}>
                {row.set.nameKo} {row.code}{row.label ? ` ${row.label}` : ""} {row.count}장
              </a>
            </li>
          ))}
          {setsForTerm.map((set) => (
            <li><a href={setHref(set)}>{set.productNameKo}</a></li>
          ))}
          {related.map((item) => (
            <li><a href={glossaryHref(item.slug)}>{item.term}</a></li>
          ))}
          {term.external?.map((link) => (
            <li><a href={link.href} rel="noopener noreferrer">{link.label}</a></li>
          ))}
        </ul>
      </>
    )}
    {groups.map((group) => (
      <section class="block">
        <div class="block-head">
          <h2><a href={setHref(group.set)}>{group.set.nameKo}</a></h2>
          <a href={setHref(group.set)}>{group.cards.length}장</a>
        </div>
        <ul class="index-list">
          {group.cards.map((card) => (
            <li>
              <a href={cardHref(group.set, card)}>
                <span class="num">{collector(card)}</span>
                <span class="index-name">
                  {cardHeading(card)}
                  {card.rarity && <span class={`rarity rarity-${card.rarity}`}>{card.rarity}</span>}
                  {card.category !== "pokemon" && <span class="rarity-name"> {card.categoryKo}</span>}
                </span>
              </a>
            </li>
          ))}
        </ul>
      </section>
    ))}
    <p class="back-link"><a href={glossaryIndexHref()}>용어집으로</a></p>
  </div>
</Base>
