---
import Base from "../../layouts/Base.astro";
import AdSlot from "../../components/AdSlot.astro";
import CardTile from "../../components/CardTile.astro";
import {
  collector,
  displayName,
  formatDate,
  formatWon,
  rarityCounts,
  sets,
  typeCounts,
  withBase,
  type CardSet,
} from "../../lib/sets";

export function getStaticPaths() {
  return sets.map((set) => ({ params: { slug: set.slug }, props: { set } }));
}

interface Props {
  set: CardSet;
}
const { set } = Astro.props;
const title = `${set.nameKo} 카드 리스트 | ${set.productNameKo}`;
const description = `${set.productNameKo} 카드 리스트 ${set.cardCount}종. 레어도, 타입별로 거르고 각 카드 페이지로 이동합니다. 한국 발매 ${formatDate(set.releaseDateKr)}.`;
const listUrl = Astro.url.href;
const jsonLd = {
  "@context": "https://schema.org",
  "@type": "CollectionPage",
  name: title,
  description,
  inLanguage: "ko-KR",
  url: listUrl,
  mainEntity: {
    "@type": "ItemList",
    numberOfItems: set.cards.length,
    itemListElement: set.cards.map((card, index) => ({
      "@type": "ListItem",
      position: index + 1,
      name: `${displayName(card)} ${collector(card)} ${card.rarity}`,
      url: new URL(withBase(`cards/${set.slug}/${card.number}/`), Astro.site).href,
    })),
  },
};
const rarities = rarityCounts(set);
const types = typeCounts(set);
const printed = String(set.printedTotal).padStart(3, "0");
---
<Base title={title} description={description} jsonLd={jsonLd}>
  <div class="wrap">
    <header class="mast">
      <p class="crumbs"><a href={withBase("")}>홈</a> / {set.nameKo}</p>
      <div class="mast-row">
        <h1>{set.nameKo} 카드 리스트</h1>
        <a class="mast-aside" href={withBase("")}>모든 세트</a>
      </div>
      <p class="lede">
        {set.productNameKo}에 수록된 {set.cardCount}장을 모았습니다. 번호는 한국 공식 카드 검색의 번호를 따릅니다.
        {set.id === "m6" && " 065번부터 076번까지는 일본판 수록 순서와 다릅니다."}
      </p>
    </header>
    <dl class="facts">
      <div><dt>한국 발매</dt><dd>{formatDate(set.releaseDateKr)}</dd></div>
      <div><dt>일본 발매</dt><dd>{formatDate(set.releaseDateJp)}</dd></div>
      {set.packsPerBox > 0 ? (
        <>
          <div><dt>팩</dt><dd>{set.cardsPerPack}장, {formatWon(set.packPriceKr)}</dd></div>
          <div><dt>상자</dt><dd>{set.packsPerBox}팩, {formatWon(set.boxPriceKr)}</dd></div>
        </>
      ) : (
        <>
          <div><dt>가격</dt><dd>{formatWon(set.packPriceKr)}</dd></div>
          <div><dt>덱</dt><dd>{set.cardsPerPack}장</dd></div>
        </>
      )}
      <div><dt>수록</dt><dd>{set.cardCount}종 ({printed}까지, 시크릿 포함)</dd></div>
      <div><dt>확장 마크</dt><dd>{set.expansionMark} / 레귤레이션 {set.regulation}</dd></div>
    </dl>
    <ul class="text-links">
      <li><a href={set.krProductUrl} rel="noopener noreferrer">한국 공식 제품 페이지</a></li>
      <li><a href={set.jpSetUrl} rel="noopener noreferrer">일본 공식 세트 페이지</a></li>
      <li><a href={withBase("rarity/")}>레어도 일람</a></li>
    </ul>
    <AdSlot id={`${set.id}-list`} />
    <div class="filters" data-card-filters>
      <div class="filter-row" data-group="rarity">
        <span class="filter-label">레어도</span>
        <div class="filter-options">
          <button type="button" data-value="all" aria-pressed="true">전체</button>
          {rarities.map((row) => (
            <button type="button" data-value={row.code} aria-pressed="false">
              {row.code}{row.label !== row.code ? ` ${row.label}` : ""} {row.count}
            </button>
          ))}
        </div>
      </div>
      <div class="filter-row" data-group="type">
        <span class="filter-label">타입</span>
        <div class="filter-options">
          <button type="button" data-value="all" aria-pressed="true">전체</button>
          {types.map((row) => (
            <button type="button" data-value={row.code} aria-pressed="false">
              <span class={`swatch swatch-${row.code}`} aria-hidden="true"></span>
              {row.label} {row.count}
            </button>
          ))}
        </div>
      </div>
      <p class="result-count" data-result-count aria-live="polite">{set.cards.length}장</p>
    </div>
    <p class="empty" data-empty hidden>해당하는 카드가 없습니다.</p>
    <div class="grid">
      {set.cards.map((card) => <CardTile set={set} card={card} />)}
    </div>
  </div>
</Base>
<script is:inline>
  const root = document.querySelector("[data-card-filters]");
  if (root) {
    const state = { rarity: "all", type: "all" };
    const cards = [...document.querySelectorAll("[data-card]")];
    const count = root.querySelector("[data-result-count]");
    const empty = document.querySelector("[data-empty]");
    function apply() {
      let shown = 0;
      for (const card of cards) {
        const rarityOk = state.rarity === "all" || card.dataset.rarity === state.rarity;
        const typeOk = state.type === "all" || card.dataset.type === state.type;
        const visible = rarityOk && typeOk;
        card.hidden = !visible;
        if (visible) shown += 1;
      }
      if (count) count.textContent = shown + "장";
      if (empty) empty.hidden = shown !== 0;
    }
    root.querySelectorAll(".filter-row").forEach((row) => {
      const group = row.dataset.group;
      row.querySelectorAll("button").forEach((button) => {
        button.addEventListener("click", () => {
          state[group] = button.dataset.value;
          row.querySelectorAll("button").forEach((item) => {
            item.setAttribute("aria-pressed", item === button ? "true" : "false");
          });
          apply();
        });
      });
    });
  }
</script>
