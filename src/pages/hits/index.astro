---
import Base from "../../layouts/Base.astro";
import AdSlot from "../../components/AdSlot.astro";
import SetRow from "../../components/SetRow.astro";
import { groupSetsBySeries, HITS_NAV_LABEL, hitGroups, hitNote, hitsSetPath } from "../../lib/hits.mjs";
import { sets, withBase } from "../../lib/sets";

const groups = groupSetsBySeries(sets);
const described = sets
  .map((set) => {
    const count = hitGroups(set).reduce((sum, group) => sum + group.cards.length, 0);
    return count ? `${set.nameKo} ${count}장` : "";
  })
  .filter(Boolean)
  .join(", ");
const title = `${HITS_NAV_LABEL} | 포켓몬 카드 한국판`;
const description = `박스별 힛카드. ${described}. 이름과 레어도는 수록 데이터에 있는 것만 보여 줍니다.`;
const jsonLd = {
  "@context": "https://schema.org",
  "@type": "CollectionPage",
  name: title,
  description,
  inLanguage: "ko-KR",
  url: Astro.url.href,
  mainEntity: {
    "@type": "ItemList",
    numberOfItems: sets.length,
    itemListElement: sets.map((set, index) => ({
      "@type": "ListItem",
      position: index + 1,
      name: `${set.productNameKo} ${HITS_NAV_LABEL}`,
      url: new URL(withBase(hitsSetPath(set)), Astro.site).href,
    })),
  },
};
---
<Base title={title} description={description} jsonLd={jsonLd}>
  <div class="wrap">
    <header class="mast">
      <p class="crumbs"><a href={withBase("")}>홈</a> / {HITS_NAV_LABEL}</p>
      <div class="mast-row">
        <h1>박스별 힛카드</h1>
        <p class="mast-aside">{sets.length}세트</p>
      </div>
      <p class="lede">
        상자를 고르면 그 세트의 높은 레어도 카드를 크게 볼 수 있습니다.
        이름과 레어도는 수록 데이터에 있는 것만 보여 줍니다.
      </p>
    </header>
    <AdSlot id="hits-index" />
    {groups.map((group) => (
      <section class="catalog">
        <div class="catalog-head">
          <h2>{group.series}</h2>
          <span>{group.sets.length}세트</span>
        </div>
        <ul class="set-list">
          {group.sets.map((set, index) => {
            const sections = hitGroups(set);
            const count = sections.reduce((sum, section) => sum + section.cards.length, 0);
            const note = hitNote(set);
            return (
              <li>
                <SetRow set={set} href={withBase(hitsSetPath(set))} eager={group === groups[0] && index === 0}>
                  {count > 0 ? (
                    <>
                      <span>{sections.map((section) => section.code).join(" ")}</span>
                      <span>{count}장</span>
                    </>
                  ) : (
                    <span>안내</span>
                  )}
                </SetRow>
                {note && <p class="set-note">{note}</p>}
              </li>
            );
          })}
        </ul>
      </section>
    ))}
  </div>
</Base>
