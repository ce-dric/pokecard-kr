---
interface Post {
  title: string;
  description: string;
  link: string;
  meta: string;
}

interface Group {
  source: string;
  label: string;
  posts: Post[];
}

interface Rank {
  href: string;
  name: string;
  rarity: string;
  collector: string;
  countLabel: string;
}

interface Props {
  countLabel?: string;
  stamp?: string;
  emptyLabel: string;
  groups?: Group[];
  ranking?: Rank[];
}

const { countLabel = "", stamp = "", emptyLabel, groups = [], ranking = [] } = Astro.props;
const hasPosts = groups.some((group) => group.posts.length > 0);
---

<section class="pulse" id="community-reactions" aria-labelledby="community-reactions-title">
  <div class="pulse-head">
    <h2 id="community-reactions-title">최근 커뮤니티 반응</h2>
    {countLabel && <p class="pulse-count">{countLabel}</p>}
  </div>
  {stamp && <p class="pulse-stamp">{stamp}</p>}
  <p class="pulse-note">
    네이버 검색이 준 제목과 짧은 요약만 보여 드립니다. 본문은 원문에서 확인해 주세요.
  </p>
  <div class:list={["pulse-layout", { "has-rank": ranking.length > 0 }]}>
    <div class="pulse-posts">
      {
        hasPosts ? (
          groups.map((group) => (
            <div class="pulse-group">
              <h3>{group.label}</h3>
              <ol class="pulse-list">
                {group.posts.map((post) => (
                  <li>
                    <a href={post.link} target="_blank" rel="nofollow noopener">
                      {post.title}
                      <span class="sr-only"> (새 창)</span>
                    </a>
                    {post.description && <p class="pulse-desc">{post.description}</p>}
                    {post.meta && <p class="pulse-meta">{post.meta}</p>}
                  </li>
                ))}
              </ol>
            </div>
          ))
        ) : (
          <p class="empty">{emptyLabel}</p>
        )
      }
    </div>
    {
      ranking.length > 0 && (
        <div class="pulse-rank-wrap">
          <h3>카드별 언급량</h3>
          <ol class="pulse-rank">
            {ranking.map((row) => (
              <li>
                <a href={row.href}>
                  <span class="pulse-rank-name">{row.name}</span>
                  <span class="pulse-rank-meta">
                    {row.rarity} {row.collector}
                  </span>
                  <span class="pulse-rank-count">{row.countLabel}</span>
                </a>
              </li>
            ))}
          </ol>
        </div>
      )
    }
  </div>
</section>
