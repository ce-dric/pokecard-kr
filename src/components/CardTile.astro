---
import {
  altText,
  cardHref,
  collector,
  displayName,
  imageHref,
  typeLabel,
  usesJapaneseName,
  type Card,
  type CardSet,
} from "../lib/sets";

interface Props {
  set: CardSet;
  card: Card;
  eager?: boolean;
}

const { set, card, eager = false } = Astro.props;
---
<article class="tile" data-card data-rarity={card.rarity} data-type={card.type || "none"}>
  <a href={cardHref(set, card)}>
    <img
      src={imageHref(set, card.thumb)}
      alt={altText(set, card)}
      width="280"
      height="391"
      loading={eager ? "eager" : "lazy"}
      decoding="async"
    />
    <span class="tile-name">
      {displayName(card)}
      {card.halfKo ? ` ${card.halfKo}` : ""}
      {usesJapaneseName(card) && <em class="ja-fallback">일본판 기준</em>}
    </span>
    <span class="tile-meta">
      <span class="num">{collector(card)}</span>
      <span class={`rarity rarity-${card.rarity}`}>{card.rarity}</span>
      {card.typeKo && <span>{typeLabel[card.type || ""] || card.typeKo}</span>}
    </span>
  </a>
</article>
