---
import { existsSync } from "node:fs";
import { join } from "node:path";
import { imageHref, withBase, type Card, type CardSet } from "../lib/sets";

interface Props {
  set: CardSet;
  href: string;
  eager?: boolean;
  useBox?: boolean;
}

const { set, href, eager = false, useBox = false } = Astro.props;
const boxName = `${set.id}.webp`;
const boxExists = useBox && existsSync(join(process.cwd(), "public", "images", "boxes", boxName));
const preferred = ["SAR", "MUR", "UR", "SR", "AR", "MA", "RR", "R"];
let cover: Card | undefined;
for (const code of preferred) {
  cover = set.cards.find((card) => card.rarity === code && card.thumb);
  if (cover) break;
}
cover ??= set.cards.find((card) => card.thumb) ?? set.cards[0];
---
<a class:list={["set-row", { "has-box": boxExists }]} href={href}>
  {boxExists ? (
    <img
      class="row-thumb row-box"
      src={withBase(`images/boxes/${boxName}`)}
      alt=""
      width="72"
      height="72"
      loading={eager ? "eager" : "lazy"}
      decoding="async"
    />
  ) : cover?.thumb ? (
    <img
      class="row-thumb"
      src={imageHref(set, cover.thumb)}
      alt=""
      width="63"
      height="88"
      loading={eager ? "eager" : "lazy"}
      decoding="async"
    />
  ) : (
    <span class="row-thumb row-fallback" aria-hidden="true"></span>
  )}
  <span class="set-main">
    <span class="set-title">{set.nameKo}</span>
    <span class="set-product">
      <span class="source">{set.expansionMark}</span>
      {set.productNameKo}
    </span>
  </span>
  <span class="set-stats"><slot /></span>
</a>
